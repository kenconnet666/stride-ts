{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "esnext.disposable", "dom", "dom.iterable"],
    "types": ["@webgpu/types", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true,
    // packages/pipeline 在 Node 里直接运行 .ts，相对导入要写扩展名
    "allowImportingTsExtensions": true,
    // 编辑器的界面（packages/editor/src/ui）用 Vue 加 vue-tsx-pro 写 TSX；别处没有 .tsx
    "jsx": "preserve",
    "jsxImportSource": "@zerodep-dev/vue-tsx-pro-tsx"
  },
  "include": ["packages/*/src", "packages/*/test", "packages/*/experiments", "apps/*/src", "apps/*/scripts", "apps/*/vite.config.ts", "tools/*.ts", "tools/editor-accept/*.ts", "vitest.config.ts"]
}
