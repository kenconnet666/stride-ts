{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sdf asset",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "materials": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "description": "content path of a material asset (no extension)"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": "material slots; a shape picks one by index"
    },
    "resolution": {
      "type": "number",
      "minimum": 0.005,
      "description": "mesh edge length: smaller is finer and slower to bake; unit: m",
      "default": 0.05
    },
    "uvScale": {
      "type": "number",
      "minimum": 0.01,
      "description": "automatic UVs: one texture repeat per this many meters; unit: m",
      "default": 1
    },
    "shapes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "sphere"
                ]
              },
              "name": {
                "type": "string"
              },
              "operation": {
                "enum": [
                  "add",
                  "subtract",
                  "intersect"
                ]
              },
              "smoothness": {
                "type": "number",
                "minimum": 0,
                "description": "how wide the blend into the shapes before it is (0 is a sharp seam); unit: m",
                "default": 0
              },
              "position": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3,
                "description": "unit: m"
              },
              "rotation": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4,
                "description": "quaternion [x, y, z, w]",
                "default": [
                  0,
                  0,
                  0,
                  1
                ]
              },
              "material": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255,
                "description": "index into materials",
                "default": 0
              },
              "radius": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "operation",
              "position",
              "radius"
            ],
            "additionalProperties": false
          },
