// 行人：平时等一会儿、附近走一走；看见 threat（挂 PerceptionStimulus、tag 是 threat 的东西）或者收到 scare 事件就背对着它跑开，
// 跑完还看得见就接着跑，看不见了回到平时
{
  "name": "Pedestrian",
  "parameters": [
    { "name": "alarm", "type": "bool" },
    { "name": "threat", "type": "vector" }
  ],
  "states": [
    {
      "name": "Calm",
      "enter": [{ "type": "parameter", "parameter": "alarm", "value": 0 }],
      "tasks": [{ "type": "sense", "tag": "threat", "sense": "sight", "store": "threat", "flag": "alarm" }],
      "transitions": [
        { "on": "event", "event": "scare", "to": "Panic" },
        { "on": "tick", "when": [{ "type": "parameter", "parameter": "alarm", "value": 1 }], "to": "Panic" }
      ]
    },
    { "name": "Idle", "parent": "Calm", "tasks": [{ "type": "wait", "seconds": 1, "random": 4 }], "transitions": [{ "to": "$next" }] },
    {
      "name": "Stroll",
      "parent": "Calm",
      "tasks": [{ "type": "wander", "radius": 20, "timeout": 40 }],
      "transitions": [{ "to": "Idle" }]
    },
    {
      "name": "Panic",
      "tasks": [
        { "type": "sense", "tag": "threat", "sense": "sight", "store": "threat", "flag": "alarm" },
        { "type": "flee", "parameter": "threat", "distance": 30 }
      ],
      "transitions": [{ "to": "$root" }]
    }
  ]
}
