// 开车：VehicleDriver 按这两个动作读（WASD、方向键、手柄左摇杆和扳机；空格手刹）
{
  "name": "Driving",
  "actions": [
    {
      "name": "drive",
      "type": "axis2",
      "bindings": [
        { "type": "dpad", "up": "key:KeyW", "down": "key:KeyS", "left": "key:KeyA", "right": "key:KeyD" },
        { "type": "dpad", "up": "key:ArrowUp", "down": "key:ArrowDown", "left": "key:ArrowLeft", "right": "key:ArrowRight" },
        { "type": "control", "control": "pad:leftStick", "deadZone": 0.15 }
      ]
    },
    {
      "name": "handBrake",
      "type": "button",
      "bindings": [
        { "type": "control", "control": "key:Space" },
        { "type": "control", "control": "pad:b" }
      ]
    }
  ]
}
