node_modules/
dist/
*.tsbuildinfo

# Machine-specific
/.idea/
/.claude/

# 从 Stride 仓库导入的内容（各个 app 的 pnpm import:stride）
/apps/*/public/content/
# 手搭的工程，内容要提交
!/apps/photoreal/public/content/
!/apps/open-world/public/content/
!/apps/campsite/public/content/
!/apps/greybox/public/content/
!/apps/short-film/public/content/
!/apps/collect-dodge/public/content/

# 共用资源包（@stride-ts/assets）同步进来的内容：开发服务器、编辑器后端、构建前从 node_modules 同步，改资源去资源仓库
/apps/*/public/content/Shared/

# 包装、货架、堆放、杂物生成的模型、标签图集、材质（几 MB 一个；编辑器后端打开工程时按源文件补烘，见 EditorBackend 的 #bakeStale）；
# 放行的是源文件（.json 或带注释的 .jsonc）
/apps/photoreal/public/content/Shop/Products/*
!/apps/photoreal/public/content/Shop/Products/*.product.json*
/apps/photoreal/public/content/Shop/Shelves/*
!/apps/photoreal/public/content/Shop/Shelves/*.shelf.json*
/apps/photoreal/public/content/Shop/Piles/*
!/apps/photoreal/public/content/Shop/Piles/*.pile.json*
/apps/photoreal/public/content/Shop/Signs/*
!/apps/photoreal/public/content/Shop/Signs/*.sign.json*
/apps/photoreal/public/content/Shop/Ceilings/*
!/apps/photoreal/public/content/Shop/Ceilings/*.ceiling.json*
/apps/photoreal/public/content/Shop/Fixtures/*
!/apps/photoreal/public/content/Shop/Fixtures/*.fixture.json*
/apps/photoreal/public/content/Subway/Debris/*
!/apps/photoreal/public/content/Subway/Debris/*.product.json*
!/apps/photoreal/public/content/Subway/Debris/*.debris.json*

# 按内容目录生成的资源句柄（@stride-ts/editor：开发服务器启动时、`stride-editor assets-types`）
/apps/*/src/assets.gen.ts

# 导出的成片、图像序列（调试命令 render、编辑器的导出）
/apps/*/exports/


# 参考素材（用户的照片和视频、网上视频的截图）：有人脸、有版权，公开仓库不提交，只在本机（见 docs/handover.md 的"参考素材"）
/reference/
