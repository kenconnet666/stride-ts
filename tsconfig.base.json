// 共用的编译选项：各子项目（packages/*、apps/*、tools）的 tsconfig.json 继承这份、只列自己的目录，检查按子项目跑（根 package.json 的 typecheck）
{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2026", "esnext.disposable", "dom", "dom.iterable"],
    "types": ["@webgpu/types", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true,
    // packages/pipeline 在 Node 里直接运行 .ts，相对导入要写扩展名
    "allowImportingTsExtensions": true,
    // 编辑器的界面（packages/editor/src/ui）用 Vue 加 vue-tsx-pro 写 TSX；别处没有 .tsx
    "jsx": "preserve",
    "jsxImportSource": "@zerodep-dev/vue-tsx-pro-tsx"
  }
}
