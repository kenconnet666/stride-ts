{
  "name": "stride-ts",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @stride-ts/sandbox dev",
    "build": "pnpm --filter @stride-ts/sandbox build",
    "typecheck": "pnpm -r --no-bail --workspace-concurrency=8 run typecheck && tsc -p tools",
    "typecheck:changed": "pnpm -r --no-bail --workspace-concurrency=8 --filter \"...[origin/main]\" run typecheck && tsc -p tools",
    "test": "pnpm -r --no-bail run test",
    "lint": "oxlint --deny-warnings .",
    "test:changed": "pnpm -r --no-bail --filter \"...[origin/main]\" run test",
    "stride": "node packages/cli/src/cli.ts"
  },
  "devDependencies": {
    "@stride-ts/cli": "workspace:*",
    "@stride-ts/editor": "workspace:*",
    "@stride-ts/engine": "workspace:*",
    "@types/node": "^26.6.6",
    "@webgpu/types": "^0.1.74",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "7.1.0-dev.20261104.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
